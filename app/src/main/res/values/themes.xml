<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Coinvane" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_strong</item>
        <item name="colorOnPrimary">#FFFFFFFF</item>
        <item name="colorPrimaryContainer">@color/brand_container</item>
        <item name="colorOnPrimaryContainer">@color/on_brand_container</item>
        <item name="colorSecondary">@color/brand</item>
        <item name="colorSecondaryContainer">@color/brand_container</item>
        <item name="colorOnSecondaryContainer">@color/on_brand_container</item>
        <item name="android:colorBackground">@color/surface</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/divider</item>
        <item name="colorSurfaceContainerLowest">@color/surface</item>
        <item name="colorSurfaceContainerLow">@color/surface_card</item>
        <item name="colorSurfaceContainer">@color/surface_card</item>
        <item name="colorSurfaceContainerHigh">@color/surface_card_high</item>
        <item name="colorSurfaceContainerHighest">@color/surface_card_high</item>
        <item name="colorControlNormal">@color/text_primary</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>

    <!-- Ekran başlığı (Piyasalar, Keşfet, Portföy, Profil): büyük değil, kalın -->
    <style name="Coinvane.ScreenTitle" parent="">
        <item name="android:textAppearance">?attr/textAppearanceTitleLarge</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- Bölüm başlığı (Piyasa Hareketi, Varlıklar...) -->
    <style name="Coinvane.SectionTitle" parent="">
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Coinvane.Caption" parent="">
        <item name="android:textAppearance">?attr/textAppearanceBodySmall</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Başlık çubuğundaki ikon düğmeleri: 48dp dokunma alanı -->
    <style name="Coinvane.IconButton" parent="">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:scaleType">center</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="tint">@color/text_primary</item>
    </style>

    <!-- Liste türü filtresi (Hacim | Favoriler | Yükselenler | Düşenler): seçili mat mor, diğerleri konturlu -->
    <style name="Coinvane.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="chipStrokeColor">@color/chip_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="chipIconTint">@color/chip_text</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipCornerRadius">12dp</item>
        <item name="chipMinHeight">36dp</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="chipIconSize">18dp</item>
        <item name="iconStartPadding">6dp</item>
    </style>

    <!-- Dönem seçici (5dk | 15dk | ...): koyu bant içinde, seçili dönem küçük mor dolgu -->
    <style name="Coinvane.Chip.Period" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="android:textColor">@color/period_text</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipCornerRadius">10dp</item>
        <item name="chipMinHeight">32dp</item>
        <item name="chipMinTouchTargetSize">40dp</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="chipStartPadding">6dp</item>
        <item name="chipEndPadding">6dp</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <style name="Kripto.Pill" parent="">
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:background">@drawable/bg_pill</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="Kripto.Stat" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="Kripto.StatLabel" parent="">
        <item name="android:textAppearance">?attr/textAppearanceLabelMedium</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="Kripto.StatValue" parent="">
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleSmall</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:maxLines">1</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">10sp</item>
        <item name="android:autoSizeMaxTextSize">14sp</item>
    </style>

    <!-- Profil satırı: ikon + başlık/değer + ok, en az 56dp -->
    <style name="Coinvane.Row" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingVertical">8dp</item>
    </style>

    <style name="Coinvane.RowIcon" parent="">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="tint">@color/text_secondary</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="Coinvane.RowTitle" parent="">
        <item name="android:textAppearance">?attr/textAppearanceBodyLarge</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Coinvane.RowValue" parent="">
        <item name="android:textAppearance">?attr/textAppearanceBodyMedium</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
</resources>
